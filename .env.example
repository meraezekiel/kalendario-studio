# Copy to .env.local (app) — see docs/cloud-setup.md. Leave empty to run without cloud features.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to show "Continue with Google" (only after Google is set up in Supabase; see docs/cloud-setup.md).
NEXT_PUBLIC_GOOGLE_AUTH=

# Copy to .env.test.local (integration tests: npm run test:cloud). Use a separate, disposable project.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_KEY=
TEST_SUPABASE_DB_PASSWORD=
# Session pooler connection string (Connect > Session pooler); the direct db host is IPv6-only.
TEST_SUPABASE_DB_URL=
